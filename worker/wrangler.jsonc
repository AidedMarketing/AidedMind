{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "aidedmind",
    "main": "src/worker.js",
    "compatibility_date": "2026-09-01",
    // Serve the app at https://aidedmind.<subdomain>.workers.dev on every deploy.
    "workers_dev": true,
    "assets": {
        "directory": "../web",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },
    "durable_objects": {
        "bindings": [{ "name": "STORE", "class_name": "Store" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
    "vars": {
        // Breakdown styles: Auto (picks per source) / Quick / Balanced / Thorough.
        "AIDEDMIND_DEFAULT_DEPTH": "auto",
        "AIDEDMIND_MODEL_QUICK": "claude-haiku-4-5",
        "AIDEDMIND_MODEL_BALANCED": "claude-sonnet-5-5",
        "AIDEDMIND_MODEL_THOROUGH": "claude-opus-5-5",
        // Gemini watches YouTube videos and backs up breakdowns during Claude outages.
        // "gemini-flash-latest" always points at Google's current Flash model.
        "GEMINI_MODEL": "gemini-flash-latest",
        "FREE_MONTHLY_CAPTURES": "25",
        "PRO_MONTHLY_CAPTURES": "400"
    },
    // Secrets (set in the Cloudflare dashboard or with `wrangler secret put`):
    //   ANTHROPIC_API_KEY  - Claude API key
    //   OWNER_TOKEN        - your personal access token (unlimited plan)
    //   GEMINI_API_KEY     - optional: transcribe videos and back up breakdowns
    //   SUPADATA_API_KEY   - optional: transcribe what's said in TikToks
    "observability": { "enabled": true }
}
