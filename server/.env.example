# Anthropic API key used for analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Long random string; enter the same value in AidedMind > Settings on each device.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AIDEDMIND_ACCESS_TOKEN=
# Optional overrides
# AIDEDMIND_MODEL=claude-opus-5
# PORT=8787
# AIDEDMIND_INBOX_PATH=server/data/inbox.json
